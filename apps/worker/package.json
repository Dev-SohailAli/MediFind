{
  "name": "@medifind/worker",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.toml --local",
    "check": "wrangler deploy --dry-run --config wrangler.local.toml",
    "d1:apply": "wrangler d1 execute medifind-synthetic-search-local --local --config wrangler.local.toml --file migrations/0001_task4_synthetic_search.sql",
    "d1:apply:synthetic": "wrangler d1 execute medifind-synthetic-search --remote --file migrations/0001_task4_synthetic_search.sql",
    "deploy:synthetic": "wrangler deploy",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:local": "node ./scripts/verify-synthetic-local.mjs"
  },
  "devDependencies": {
    "@medifind/config": "workspace:*",
    "@medifind/contracts": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "^4.123.0"
  }
}
