{
  "name": "medifind",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "test": "vitest run && pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "security:secrets": "gitleaks detect --source . --redact --exit-code 1",
    "security:trivy": "trivy fs --scanners vuln,misconfig --exit-code 1 --severity CRITICAL,HIGH --ignore-unfixed .",
    "audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@medifind/config": "workspace:*",
    "@types/node": "^24.13.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "description": "MediFind is a documentation-first plan for a Suva, Fiji pilot that helps buyers find medicines at verified pharmacies.",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-SohailAli/MediFind.git"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Dev-SohailAli/MediFind/issues"
  },
  "homepage": "https://github.com/Dev-SohailAli/MediFind#readme"
}
